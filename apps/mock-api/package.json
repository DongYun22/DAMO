{
  "name": "@damo/mock-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/server.test.ts src/naver-search.test.ts src/postgres-store.test.ts"
  },
  "dependencies": {
    "@damo/contracts": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "tsx": "^4.20.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.9.2"
  }
}
