# Supabase Connect의 Session pooler 연결 문자열을 사용합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:5432/postgres

# 초대 링크(shareUrl)를 만들 때 사용하는 웹 주소입니다. 비워두면 http://localhost:5173을 씁니다.
# Render 등 배포 환경에서는 반드시 실제 배포 주소로 설정하세요.
WEB_BASE_URL=

# 네이버 Developers의 검색 API 애플리케이션에서 발급받습니다.
# Client Secret은 VITE_ 접두사를 붙이거나 브라우저 코드에 넣지 마세요.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
